# Chép file này thành .env rồi điền khoá thật.
# .env đã nằm trong .gitignore — không bao giờ lọt vào git.
# Lấy khoá Gemini ở https://aistudio.google.com/apikey

GEMINI_API_KEY=
# Khoá API cho 9router hoặc OpenAI-compatible local/remote endpoint
OPENAI_API_KEY=

# Bot Telegram báo cáo tình hình (tạo ở @BotFather)
TELEGRAM_BOT_TOKEN=
# Chat nhận tin: `uv run reup telegram chat-id` sau khi nhắn cho bot
TELEGRAM_CHAT_ID=

# Mật khẩu bảo vệ giao diện web (không bắt buộc nếu chỉ chạy local)
REUP_WEB_PASSWORD=
# Khoá bí mật để ký session web (nếu trống thì dùng mật khẩu)
REUP_WEB_SECRET=
